{
  "name": "shipyard",
  "version": "0.1.0",
  "private": true,
  "description": "A local crew of specialist Claude Code and Codex agents that builds features and fixes bugs in your repos, with test gates, worktree isolation and an eval suite.",
  "type": "module",
  "bin": {
    "shipyard": "./bin/shipyard.mjs"
  },
  "scripts": {
    "shipyard": "tsx src/cli.ts",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "eval:validate": "tsx src/cli.ts eval --validate",
    "demo:init": "tsx src/cli.ts demo-init",
    "demo:record": "node e2e/record-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.329",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
